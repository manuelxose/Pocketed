{"nodes": [{"id": "pm_sports_bias", "label": "PM_SPORTS_BIAS.md", "file_type": "paper", "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pm_sports_bias_favourite_longshot_bias", "label": "Favourite-Longshot Bias", "file_type": "rationale", "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Favourites (90-99c) underpriced (+1.28 to +1.38c EV/contract) and longshots (1-10c) overpriced (-2.24c EV/contract) \u2014 symmetric both-tails pattern treated as a real bias rather than a mined artifact. Dies above a 1.5c spread; only 3 of 4 quarterly samples positive."}, {"id": "pm_sports_bias_sports_favourite_bias_example", "label": "examples/sports-favourite-bias.py", "file_type": "code", "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pm_sports_bias_krypt_scout_db", "label": "Krypt Scout Tracker DB (kryptscout.sqlite)", "file_type": "concept", "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pm_sports_bias_market_calibration", "label": "Market Calibration Finding", "file_type": "rationale", "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implied vs actual win rate matches within ~1 percentage point across price bands at T-60 \u2014 the market is otherwise well priced, so a better forecasting model will not find edge in the middle of the curve."}, {"id": "pm_sports_bias_crypto_deep_favourite_contrast", "label": "Crypto Deep-Favourite Trade Contrast", "file_type": "rationale", "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same structural bet on Polymarket crypto 15m windows is negative in every band (0.95-0.98c -0.57c/ct, 0.98-0.99c -0.73c/ct at t=-3.1). Venue and market type matter more than the shape of the bet; do not generalize the sports result to crypto windows."}], "edges": [{"source": "pm_sports_bias", "target": "pm_sports_bias_favourite_longshot_bias", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "weight": 1.0}, {"source": "pm_sports_bias", "target": "pm_sports_bias_sports_favourite_bias_example", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "weight": 1.0}, {"source": "pm_sports_bias_favourite_longshot_bias", "target": "pm_sports_bias_sports_favourite_bias_example", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "weight": 1.0}, {"source": "pm_sports_bias", "target": "pm_sports_bias_krypt_scout_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "weight": 1.0}, {"source": "pm_sports_bias", "target": "pm_sports_bias_market_calibration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "weight": 1.0}, {"source": "pm_sports_bias", "target": "pm_sports_bias_crypto_deep_favourite_contrast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/PM_SPORTS_BIAS.md", "source_location": null, "weight": 1.0}, {"source": "pm_sports_bias_crypto_deep_favour