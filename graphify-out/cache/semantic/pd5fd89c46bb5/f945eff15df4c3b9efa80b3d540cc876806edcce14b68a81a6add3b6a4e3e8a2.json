{"nodes": [{"id": "momentum_oos", "label": "MOMENTUM_OOS.md", "file_type": "paper", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "momentum_oos_btc_momentum_strategy", "label": "BTC 15m Price-Momentum Strategy", "file_type": "rationale", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "velocity1mPct > \u00b10.1 triggers a buy on that side. Original headline number (+28.50c/ct at 0.65) existed only as an unreproducible code comment in probe_btc_momentum.py, prompting this reproducible re-analysis."}, {"id": "momentum_oos_pmxt_archive", "label": "PMXT Archive (r2v2.pmxt.dev)", "file_type": "concept", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "momentum_oos_pmxt_backfill", "label": "pmxt_backfill.py", "file_type": "code", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "momentum_oos_probe_btc_momentum", "label": "probe_btc_momentum.py", "file_type": "code", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "momentum_oos_momentum_cap_sweep", "label": "momentum_cap_sweep.py", "file_type": "code", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "momentum_oos_momentum_band_stability", "label": "momentum_band_stability.py", "file_type": "code", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "momentum_oos_baseline_fill_model", "label": "Baseline Fill Model", "file_type": "rationale", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fills at the ask observed on the tick the signal fires; overly optimistic \u2014 inflates edge especially in attractive-looking bands."}, {"id": "momentum_oos_honest_fill_model", "label": "Honest (Combined) Fill Model", "file_type": "rationale", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fills only if the ask was unchanged for the previous 15s AND still within 1c 5s later, filled at the later price \u2014 approximates whether the quote was actually there long enough to hit. Under this model ~95% of the 0.20-0.40 band's apparent entries disappear."}, {"id": "momentum_oos_65c_ask_cap", "label": "65c Ask Cap Parameter", "file_type": "rationale", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fit to only 20 live fills; out-of-sample the 65-80c band is roughly neutral under honest fills (-0.12c/ct, t=-0.0), so the cap is neither supported nor contradicted \u2014 leave it, don't cite the old justification."}, {"id": "momentum_oos_daily_stop_interaction", "label": "Daily-Stop Interaction Risk", "file_type": "rationale", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most robust variant (1-10c band) has ~8.6% win rate; at ~5c entries the $1 min-notional forces ~20 contracts, so a run of ~20 losses is likely and can trip a -$20 daily stop even though the strategy is +EV."}, {"id": "momentum_oos_btc_momentum_example", "label": "examples/btc-momentum.py", "file_type": "code", "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "momentum_oos", "target": "momentum_oos_btc_momentum_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "weight": 1.0}, {"source": "momentum_oos", "target": "momentum_oos_pmxt_archive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "weight": 1.0}, {"source": "momentum_oos", "target": "momentum_oos_pmxt_backfill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "weight": 1.0}, {"source": "momentum_oos_btc_momentum_strategy", "target": "momentum_oos_probe_btc_momentum", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "weight": 1.0}, {"source": "momentum_oos_pmxt_backfill", "target": "momentum_oos_pmxt_archive", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "weight": 1.0}, {"source": "momentum_oos", "target": "momentum_oos_momentum_cap_sweep", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "weight": 1.0}, {"source": "momentum_oos", "target": "momentum_oos_momentum_band_stability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "python/research/MOMENTUM_OOS.md", "source_location": null, "weight": 1.0}, {"source": "momentum_oos_momentum_cap_sweep", "target": "momentum_oos_65c_ask_cap", "relation": "refere