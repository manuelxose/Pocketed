{
  "name": "krypt-polybot",
  "productName": "Krypt PolyBot",
  "version": "2.0.0",
  "description": "A free, fully-featured Polymarket auto-trading bot.",
  "author": { "name": "Krypt", "email": "hi@krypt.cc", "url": "https://krypt.cc" },
  "homepage": "https://krypt.cc/tools/polybot",
  "repository": { "type": "git", "url": "https://github.com/scripflipped/krypt-polybot.git" },
  "bugs": { "url": "https://github.com/scripflipped/krypt-polybot/issues" },
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "node scripts/setup-python.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "py:setup": "node scripts/setup-python.mjs",
    "py:test": "node scripts/test-python.mjs",
    "py:backtest": "node scripts/backtest.mjs",
    "py:backtest15m": "node scripts/backtest.mjs --c15",
    "py:volume": "node scripts/volume-farm.mjs",
    "test:e2e": "npm run build && node e2e/arming.e2e.mjs",
    "py:dist": "node scripts/build-python.mjs"
  },
  "dependencies": { "@tanstack/react-query": "^5.102.8" },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "codemirror": "^6.0.2",
    "jsdom": "^30.0.1",
    "lucide-react": "^0.368.0",
    "playwright-core": "^1.49.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.9",
    "vitest": "^4.1.11"
  }
}
