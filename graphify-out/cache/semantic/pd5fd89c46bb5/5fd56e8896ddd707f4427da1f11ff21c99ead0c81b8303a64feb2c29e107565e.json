{"nodes": [{"id": "readme", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_whale_tracker", "label": "Whale Tracker", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_momentum_scanner", "label": "Momentum Scanner", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_15min_crypto", "label": "15-Minute Crypto Module", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_custom_strategy_scripts", "label": "Custom Strategy Scripts", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_copy_trading", "label": "Copy Trading", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_auto_trader", "label": "Auto-Trader Engine", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shadow_mode", "label": "Shadow Mode", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every new script starts in shadow: it runs against live ticks through every rail but the exchange call is replaced by a recorded entry, so a script builds a genuine forward track record before spending money. Closest thing the app has to a paper mode, placed exactly where risk is highest (user/AI-written code)."}, {"id": "readme_sandboxed_scripts", "label": "Sandboxed Scripts (AST validation)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AST-level validation (no imports/classes/dunder/frame access) under CPU/time budget is a guardrail against accidental damage and naive-malicious code, not a hard security boundary \u2014 CPython sandboxes are escapable by a determined attacker."}, {"id": "readme_trusted_mode", "label": "Trusted Mode", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skips language validation entirely and runs with the same privileges as the trading engine, in the process holding the decrypted wallet key. Only for scripts the user has read and understood. Bypasses the language sandbox only, never the money rails."}, {"id": "readme_safety_rails", "label": "Script Safety Rails", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Max entry price, max contracts per order, max open positions per script, per-script daily-loss breaker, cap on concurrent scripts, one entry attempt per market window. Where a cap and exchange minimum contradict, entry is refused, never rounded up past the cap."}, {"id": "readme_risk_audit", "label": "Script Risk Audit", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every script is statically scanned for network access, filesystem writes, subprocesses, credential-shaped names, dynamic execution, and obfuscation (flagged critical); shown on the Risk tab, re-surfaced when arming a flagged script."}, {"id": "readme_decide_market_hook", "label": "decide_market(market) Hook", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_decide_hook", "label": "decide(ctx) Hook", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_manage_hook", "label": "manage(position, ctx) Hook", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_backtesting", "label": "Script Backtesting", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately pessimistic report: resting limits not modeled as maker fills, exit fills into a recorded bid flagged optimistic, script_max_open and daily-loss breaker not simulated \u2014 live is a rail-limited subset of the backtest, and it is in-sample by construction."}, {"id": "readme_backend_reliability_resolution", "label": "Resolution via Direct API", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconciles unresolved positions against the Gamma market (closed + outcomePrices) and on-chain positions directly, so a settled market no longer sits in filled forever and blocks new trades."}, {"id": "readme_startup_reconciliation", "label": "Startup Reconciliation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "reconcile_positions_with_polymarket() rebuilds the local book from live Polymarket positions on launch, so a crash mid-fill doesn't permanently inflate the count."}, {"id": "readme_idempotent_signing", "label": "Idempotent Signing", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLOB orders are EIP-712 signed locally and deduped by signal, so a restart never double-trades the same signal."}, {"id": "readme_electron_renderer", "label": "Electron + React Renderer", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_python_backend", "label": "Python Backend (child process)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_window_krypt_ipc", "label": "window.krypt.* IPC", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_reconcile_positions_with_polymarket", "label": "reconcile_positions_with_polymarket()", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_py_backtest15m", "label": "npm run py:backtest15m", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_py_backtest", "label": "npm run py:backtest", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_test_e2e", "label": "npm run test:e2e", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dpapi_encryption", "label": "